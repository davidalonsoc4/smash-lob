# Auth.js / Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local: opcional o http://localhost:3000
# Producción: https://tu-dominio.vercel.app

# URL pública estable usada al generar enlaces de invitación.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VARIANT=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Producción: false
# Desarrollo demo: true solo si quieres volver a ver datos fake locales
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Opcional: acceso global de emergencia desde cliente.
# Mejor para producción: usa app_users.is_superuser = true en Supabase.
NEXT_PUBLIC_SUPERUSER_EMAILS=smashlobadmin@gmail.com
NEXT_PUBLIC_SUPERUSER_PLAYER_IDS=

# Opcional: activa el autocompletado de ubicaciones con Google Places.
# Si se deja vacío, se puede guardar dirección manual y abrir Maps/Waze por búsqueda.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Push notifications Web Push / VAPID
# Genera las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@example.com

# Necesaria para las rutas de servidor que guardan suscripciones y envían push.
# No debe llevar prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# External cron protection for /api/notifications/scheduled-check
CRON_SECRET=

# Herramientas QA para simular acciones de jugadores.
# Activa ambas solo en el entorno de pruebas. El servidor sigue exigiendo rol admin.
NEXT_PUBLIC_QA_MODE=false
QA_MODE=false
