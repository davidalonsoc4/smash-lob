{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smashandlob.com/schemas/avatar-manifest-v1.json",
  "title": "Smash & Lob AvatarAssetManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "recipeSchemaVersion",
    "demoVersion",
    "worlds",
    "masterTemplate",
    "assets"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "recipeSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "demoVersion": {
      "type": "string",
      "const": "Avatar Lab DEMO 0.1"
    },
    "worlds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "available",
          "rendererId"
        ],
        "properties": {
          "id": {
            "enum": [
              "pixel_chibi",
              "chibi_illustrated"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "rendererId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "masterTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "viewBox",
        "gridUnit",
        "recommendedPixelStep",
        "centerAxisX",
        "groundLineY",
        "characterTopY",
        "characterBottomY",
        "headBounds",
        "torsoBounds",
        "dominantRacketBoundsRightHanded",
        "safeMargin",
        "lightingDirection"
      ],
      "properties": {
        "world": {
          "const": "pixel_chibi"
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 0
            },
            {
              "const": 192
            },
            {
              "const": 240
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "gridUnit": {
          "type": "integer",
          "const": 2
        },
        "recommendedPixelStep": {
          "type": "integer",
          "const": 4
        },
        "centerAxisX": {
          "type": "integer",
          "const": 96
        },
        "groundLineY": {
          "type": "integer",
          "const": 232
        },
        "characterTopY": {
          "type": "integer"
        },
        "characterBottomY": {
          "type": "integer"
        },
        "headBounds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "torsoBounds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "dominantRacketBoundsRightHanded": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "safeMargin": {
          "type": "integer",
          "minimum": 0
        },
        "lightingDirection": {
          "const": "top_left"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "supportsColor",
          "rendererPrimitive",
          "worldVariants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "supportsColor": {
            "type": "boolean"
          },
          "rendererPrimitive": {
            "type": "string"
          },
          "worldVariants": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pixel_chibi",
              "chibi_illustrated"
            ],
            "properties": {
              "pixel_chibi": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rendererPrimitive"
                ],
                "properties": {
                  "rendererPrimitive": {
                    "type": "string"
                  }
                }
              },
              "chibi_illustrated": {
                "type": "null"
              }
            }
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "excludes"
            ],
            "properties": {
              "excludes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
