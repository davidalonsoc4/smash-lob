{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smashandlob.com/schemas/avatar-recipe-v1.json",
  "title": "Smash & Lob AvatarRecipe v1",
  "description": "Receta neutral independiente del mundo visual.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handedness",
    "skinTone",
    "head",
    "hair",
    "beard",
    "eyes",
    "eyebrows",
    "cap",
    "headband",
    "shirt",
    "shorts",
    "compressionSleeve",
    "wristband",
    "socks",
    "shoes",
    "racket"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "handedness": {
      "enum": [
        "right",
        "left"
      ]
    },
    "skinTone": {
      "enum": [
        "light_warm",
        "medium_warm"
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "const": "round_01"
        }
      }
    },
    "hair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "color"
      ],
      "properties": {
        "style": {
          "enum": [
            "none",
            "messy_short_01",
            "short_up_01"
          ]
        },
        "color": {
          "enum": [
            "dark_brown",
            "black"
          ]
        }
      }
    },
    "beard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "color"
      ],
      "properties": {
        "style": {
          "enum": [
            "none",
            "short_full_01",
            "goatee_01"
          ]
        },
        "color": {
          "enum": [
            "dark_brown",
            "black"
          ]
        }
      }
    },
    "eyes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "color"
      ],
      "properties": {
        "style": {
          "const": "vertical_01"
        },
        "color": {
          "enum": [
            "dark_brown",
            "blue"
          ]
        }
      }
    },
    "eyebrows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "color"
      ],
      "properties": {
        "style": {
          "enum": [
            "thick_straight_01",
            "angled_01"
          ]
        },
        "color": {
          "enum": [
            "dark_brown",
            "black"
          ]
        }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "color"
      ],
      "properties": {
        "style": {
          "enum": [
            "none",
            "backwards_01"
          ]
        },
        "color": {
          "enum": [
            "white",
            "black"
          ]
        }
      }
    },
    "headband": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "color"
      ],
      "properties": {
        "style": {
          "enum": [
            "none",
            "basic_01"
          ]
        },
        "color": {
          "enum": [
            "white",
            "red"
          ]
        }
      }
    },
    "shirt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "primaryColor",
        "secondaryColor"
      ],
      "properties": {
        "model": {
          "const": "technical_basic_01"
        },
        "primaryColor": {
          "enum": [
            "light_blue",
            "green"
          ]
        },
        "secondaryColor": {
          "enum": [
            "light_blue_shadow",
            "green_shadow",
            "white",
            "black"
          ]
        }
      }
    },
    "shorts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "primaryColor",
        "secondaryColor"
      ],
      "properties": {
        "model": {
          "const": "basic_01"
        },
        "primaryColor": {
          "enum": [
            "black",
            "navy"
          ]
        },
        "secondaryColor": {
          "enum": [
            "charcoal",
            "black"
          ]
        }
      }
    },
    "compressionSleeve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "side",
        "color"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "side": {
          "enum": [
            "dominant",
            "non_dominant"
          ]
        },
        "color": {
          "enum": [
            "black",
            "white"
          ]
        }
      }
    },
    "wristband": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "side",
        "color"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "side": {
          "enum": [
            "dominant",
            "non_dominant"
          ]
        },
        "color": {
          "enum": [
            "white",
            "black"
          ]
        }
      }
    },
    "socks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "primaryColor"
      ],
      "properties": {
        "length": {
          "enum": [
            "high",
            "short"
          ]
        },
        "primaryColor": {
          "enum": [
            "white",
            "black"
          ]
        }
      }
    },
    "shoes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "primaryColor",
        "secondaryColor"
      ],
      "properties": {
        "model": {
          "const": "court_01"
        },
        "primaryColor": {
          "enum": [
            "white",
            "light_blue"
          ]
        },
        "secondaryColor": {
          "enum": [
            "black",
            "white"
          ]
        }
      }
    },
    "racket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "primaryColor",
        "secondaryColor"
      ],
      "properties": {
        "model": {
          "enum": [
            "round_b_01",
            "diamond_stripe_01"
          ]
        },
        "primaryColor": {
          "enum": [
            "white",
            "black"
          ]
        },
        "secondaryColor": {
          "enum": [
            "black",
            "light_blue"
          ]
        }
      }
    }
  }
}
